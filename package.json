{
  "name": "claude-maid",
  "displayName": "Claude Maid",
  "description": "Claude Code の入力欄の右上に、ちっちゃいメイドさんを常駐させます",
  "version": "0.0.0",
  "publisher": "nicoyou",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicoyou/ClaudeMaid.git"
  },
  "bugs": {
    "url": "https://github.com/nicoyou/ClaudeMaid/issues"
  },
  "homepage": "https://github.com/nicoyou/ClaudeMaid#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "maid",
    "pixel-art",
    "pet"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "scripts": {
    "vscode:uninstall": "node ./src/uninstall.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeMaid.show",
        "title": "メイドさんを呼ぶ",
        "category": "Claude Maid"
      },
      {
        "command": "claudeMaid.hide",
        "title": "メイドさんをお休みさせる",
        "category": "Claude Maid"
      },
      {
        "command": "claudeMaid.reapply",
        "title": "メイドさんを再配置する",
        "category": "Claude Maid"
      }
    ],
    "configuration": {
      "title": "Claude Maid",
      "properties": {
        "claudeMaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "メイドさんを表示する"
        },
        "claudeMaid.character": {
          "type": "string",
          "default": "random",
          "enum": [
            "random",
            "twintail",
            "catmaid",
            "apprentice",
            "blackhair",
            "blonde",
            "oneesan"
          ],
          "enumDescriptions": [
            "チャットを開くたびにランダムで1人",
            "ツインテールメイド",
            "猫耳メイド",
            "見習いメイド",
            "黒髪メイド",
            "金髪メイド",
            "お姉さんメイド"
          ],
          "description": "表示するメイドさん"
        },
        "claudeMaid.size": {
          "type": "number",
          "default": 100,
          "minimum": 16,
          "maximum": 300,
          "description": "メイドさんの大きさ。100 で 1 ドット=1px、200 で2倍"
        },
        "claudeMaid.offsetRight": {
          "type": "number",
          "default": 14,
          "description": "入力欄の右端からの距離"
        },
        "claudeMaid.fadeOpacity": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "マウスを近づけたときのメイドさんの不透明度"
        },
        "claudeMaid.showGreeting": {
          "type": "boolean",
          "default": true,
          "description": "入力欄をクリックしたときに、メイドさんが吹き出しで話す"
        },
        "claudeMaid.greeting": {
          "type": "string",
          "default": "",
          "description": "入力欄をクリックしたときの吹き出しのセリフ。空ならメイドさんごとの専用のセリフからランダム。"
        },
        "claudeMaid.greetingSeconds": {
          "type": "number",
          "default": 3.5,
          "description": "吹き出しを表示する秒数"
        },
        "claudeMaid.imagePath": {
          "type": "string",
          "default": "",
          "description": "好きな画像 (png / gif / svg / webp) の絶対パス"
        }
      }
    }
  }
}
